# apps/app/.env (template — NO real secrets; real values live in Infisical project comp-ai)
# Mirrors .env.example, tailored for the MVS self-host.

# ---- Self-host ----
NEXT_PUBLIC_SELF_HOSTED=true            # auto-approves org, bypasses Stripe/booking

# ---- Database (dedicated Neon project mvs-compliance-comp) ----
DATABASE_URL=postgresql://__SET_IN_INFISICAL__@__NEON_HOST__/comp?sslmode=require

# ---- Auth (Better Auth) ----
AUTH_SECRET=__SET_IN_INFISICAL__       # openssl rand -base64 32
SECRET_KEY=__SET_IN_INFISICAL__
BETTER_AUTH_URL=https://comp.mvsapps.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://comp.mvsapps.com
AUTH_TRUSTED_ORIGINS=https://comp.mvsapps.com,https://comp-portal.mvsapps.com

# ---- Email (Resend — compliance notifications only, NO PHI) ----
RESEND_API_KEY=__SET_IN_INFISICAL__
RESEND_DOMAIN=mail.mvsapps.com
RESEND_FROM_SYSTEM=compliance@mail.mvsapps.com
RESEND_FROM_DEFAULT=compliance@mail.mvsapps.com

# ---- Workflows ----
TRIGGER_SECRET_KEY=__SET_IN_INFISICAL__

# ---- Misc ----
REVALIDATION_SECRET=__SET_IN_INFISICAL__   # openssl rand -base64 32
NEXT_PUBLIC_PORTAL_URL=https://comp-portal.mvsapps.com
TRUST_APP_URL=https://comp-trust.mvsapps.com

# ---- Optional: S3 attachments (KMS-encrypted bucket in agenthub-prod account) ----
APP_AWS_ACCESS_KEY_ID=__SET_IN_INFISICAL__
APP_AWS_SECRET_ACCESS_KEY=__SET_IN_INFISICAL__
APP_AWS_REGION=__SET__
APP_AWS_BUCKET_NAME=__SET__

# ---- Optional: AI features — route via LiteLLM gateway, NOT a raw provider key in prod ----
OPENAI_API_KEY=__SET_IN_INFISICAL__    # point at the LiteLLM gateway base URL/key
